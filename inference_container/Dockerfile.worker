# syntax=docker/dockerfile:1
# Kafka-only worker service
# Consumes Kafka topics and updates promotion pointers

ARG PYTHON_VERSION=3.11.4
FROM python:${PYTHON_VERSION}-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
ENV GIT_PYTHON_REFRESH=quiet

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "${UID}" \
    appuser

# Install dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=bind,source=inference_container/requirements.txt,target=requirements.txt \
    python -m pip install -r requirements.txt

USER appuser

COPY inference_container/ .
COPY shared/ /app/shared/

# Kafka worker configuration
ENV USE_MANUAL_COMMIT=true \
    FETCH_MAX_WAIT_MS=50 \
    MAX_POLL_RECORDS=64

# Entrypoint: Kafka-only worker
CMD ["python", "inference_worker.py"]
